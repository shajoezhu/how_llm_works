# dependencies
/node_modules
/.pnp
.pnp.js

.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# tailwind
.turbo
.vscode
styles/dist.css

*.wat
src/cpu/tests/*_.s
*.o
*.ll

# --- LLM webpage repo: ignore non-LLM (CPU demo) content & dev cruft ---
# The CPU simulator section is excluded from the LLM-only deployment.
/src/app/cpu/
/src/cpu/
/public/riscv/

# Brendan's progress screenshots
/progress/

# Unchecked-out submodule reference (minGPT) — not needed for the webpage
/.gitmodules
/minGPT/

# yarn berry artifacts (this project is built with npm)
/.yarnrc.yml
/.yarn/releases/
/yarn.lock

# logs / caches / OS / editor
*.log
.eslintcache
.cache/
Thumbs.db
